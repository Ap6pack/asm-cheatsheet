# Copy to .env.local for local development. All values are optional.

# Canonical site URL — used for sitemap generation and absolute Open Graph
# image URLs. Defaults to the production Vercel URL when unset.
NEXT_PUBLIC_SITE_URL=https://asm-cheatsheet.vercel.app

# --- Optional analytics (off unless configured) -----------------------------
# Both providers are cookieless and collect no personal data. Set ONE of them.
#
# Plausible (hosted or self-hosted)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=asm-cheatsheet.vercel.app
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
#
# Umami (self-hosted)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_UMAMI_HOST=https://analytics.example.com
